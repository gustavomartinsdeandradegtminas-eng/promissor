# Este repositório é público (GitHub Pages). Só sobem os arquivos do site.
# Tudo o resto (instruções, referências, ferramentas, versão 1) fica só no computador.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/css/
!/js/
!/assets/
/assets/*
!/assets/img/
!/assets/fonts/
!/favicon.ico
!/favicon-32.png
!/apple-touch-icon.png
!/icon-192.png
!/icon-512.png
!/site.webmanifest
!/og-image.jpg
!/robots.txt
